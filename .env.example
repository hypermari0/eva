# --- Required ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
OPENROUTER_API_KEY=your-openrouter-api-key
SUPABASE_URL=https://your-project.supabase.co
# Use the service_role key (NOT anon key) — RLS blocks anon access
SUPABASE_KEY=your-supabase-service-role-key

# --- Optional: tools ---
# Web search
TAVILY_API_KEY=
# Connect external apps (Google Calendar, Gmail, Slack, GitHub, etc.)
COMPOSIO_API_KEY=
# Voice transcription + TTS. Without it, voice messages are disabled.
GROQ_API_KEY=

# --- Security ---
# Comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone (NOT recommended — your API keys pay for every message).
ALLOWED_USER_IDS=
# Max messages per user per window (sliding window, simple in-memory limiter).
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW=60

# --- Daily briefing (optional) ---
# The Telegram user ID that receives the daily briefing. Leave empty to disable.
OWNER_USER_ID=
# IANA timezone for the briefing (e.g. Europe/Lisbon, America/New_York). Default: UTC
BRIEFING_TIMEZONE=UTC
# Local 24h time for the briefing. Default: 08:00
BRIEFING_HOUR=8
BRIEFING_MINUTE=0
# Optional extra local-news topic appended to the briefing (e.g. "Portugal", "NYC tech scene").
BRIEFING_LOCAL_REGION=
